# LUKSO Mainnet RPC endpoint used for all on-chain reads (ERC725Y/LSP6/LSP3).
NEXT_PUBLIC_LUKSO_MAINNET_RPC_URL=https://rpc.mainnet.lukso.network

# LUKSO Mainnet chain identifier (used for network validation / wallet checks).
NEXT_PUBLIC_LUKSO_MAINNET_CHAIN_ID=42

# LUKSO Mainnet Blockscout explorer API base URL, used for the staleness/last-activity
# indicator (Phase 3, Step 3.5). Exact endpoint path to be confirmed against LUKSO's
# live Blockscout instance when that step is reached.
NEXT_PUBLIC_LUKSO_BLOCKSCOUT_API_BASE_URL=https://explorer.execution.mainnet.lukso.network/api

# IPFS gateway used to resolve LSP3 profile metadata (name/avatar) and any other
# VerifiableURI-based content. LUKSO's own gateway is documented as development-use
# only (no SLA, rate limits may apply) — worth revisiting before a production launch.
NEXT_PUBLIC_IPFS_GATEWAY_URL=https://api.universalprofile.cloud/ipfs

# Identifier for the Grid-embedded wallet-connection package (@lukso/up-provider), if one
# is required by that package. To be confirmed once Phase 4, Step 4.3 is reached.
# NEXT_PUBLIC_UP_PROVIDER_APP_ID=
